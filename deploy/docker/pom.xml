<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-community-services-rendering2-deploy</artifactId>
    <version>git</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>edu_sharing-community-services-rendering2-deploy-docker</artifactId>
  <packaging>pom</packaging>

  <name>edu_sharing-community-services-rendering2-deploy-docker</name>

  <properties>

    <docker.from.openjdk.21>
      dockerio.mirror.docker.edu-sharing.com/eclipse-temurin:21-jre-alpine-3.24
    </docker.from.openjdk.21>

    <docker.from.eclipse-temurin.21>
      dockerio.mirror.docker.edu-sharing.com/eclipse-temurin:21-jre-alpine-3.24
    </docker.from.eclipse-temurin.21>

    <docker.from.node.24>
      dockerio.mirror.docker.edu-sharing.com/node:24-alpine3.24
    </docker.from.node.24>

    <!-- Builder and runtime stage must stay on the same Debian release (the venv is copied across). -->
    <docker.from.python.3.13>
      dockerio.mirror.docker.edu-sharing.com/python:3.13-trixie
    </docker.from.python.3.13>

    <docker.from.python.3.13-slim>
      dockerio.mirror.docker.edu-sharing.com/python:3.13-slim-trixie
    </docker.from.python.3.13-slim>

    <!-- The versions of the edu-sharing images (docker.edu_sharing.community.common.*) live in the root pom.xml: the
         service integration tests read the same versions for their Testcontainers, see service/src/test/resources/docker-images.properties. -->

    <helm.kube.version>&gt;= 1.20.0-0</helm.kube.version>
    <helm.version>3.14.2</helm.version>

  </properties>

  <modules>
    <module>compose</module>
    <module>build</module>
    <module>helm</module>
  </modules>

</project>
