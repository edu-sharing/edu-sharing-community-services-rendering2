<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm</artifactId>
    <version>git</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-lumi</artifactId>
  <packaging>jar</packaging>

  <name>edu_sharing-community-services-rendering2-deploy-docker-helm-lumi</name>

  <build>

    <plugins>

      <plugin>
        <groupId>io.kokuwa.maven</groupId>
        <artifactId>helm-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>init</id>
            <goals>
              <goal>init</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
          <execution>
            <id>dependency-build</id>
            <goals>
              <goal>dependency-build</goal>
            </goals>
            <phase>compile</phase>
          </execution>
          <execution>
            <id>lint</id>
            <goals>
              <goal>lint</goal>
            </goals>
            <phase>test</phase>
          </execution>
          <!-- Lint and package only see the default values; render the opt-in branches too, so that a
               missing default or a template error in them fails the build. Values files live outside the chart. -->
          <execution>
            <id>template-shared-bucket-and-database</id>
            <goals>
              <goal>template</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <!-- the template goal is skipped by default -->
              <skipTemplate>false</skipTemplate>
              <values>
                <yamlFile>${project.basedir}/src/test/helm/shared-bucket-and-database.yaml</yamlFile>
              </values>
            </configuration>
          </execution>
          <execution>
            <id>template-mongodb-url-override</id>
            <goals>
              <goal>template</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <!-- the template goal is skipped by default -->
              <skipTemplate>false</skipTemplate>
              <values>
                <yamlFile>${project.basedir}/src/test/helm/mongodb-url-override.yaml</yamlFile>
              </values>
            </configuration>
          </execution>
          <execution>
            <id>package</id>
            <goals>
              <goal>package</goal>
            </goals>
            <phase>package</phase>
          </execution>
          <execution>
            <id>upload</id>
            <goals>
              <goal>upload</goal>
            </goals>
            <phase>deploy</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>assembly</id>
            <goals>
              <goal>single</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

</project>
