<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-super-pom</artifactId>
    <version>develop-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>edu_sharing-community-services-rendering2</artifactId>
  <version>git</version>
  <packaging>pom</packaging>

  <name>edu_sharing-community-services-rendering2</name>

  <properties>
    <java.version>21</java.version>
    <kotlin.version>2.4.20</kotlin.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <docker.image.name>enterprise/edu_sharing-community-services-rendering2</docker.image.name>
    <docker.registry>docker.edu-sharing.com</docker.registry>


    <!-- Docker images of the infrastructure services (MongoDB, Redis, RabbitMQ, S3, ...). One place for both consumers:
         the Helm charts and compose files (deploy/docker, filtered into values.yaml and the compose YAML) and the service
         integration tests, whose Testcontainers use the same upstream versions (service/src/test/resources/docker-images.properties).
         Bump a version here and deployment and tests move together. -->
    <docker.edu_sharing.community.common.redis.name>
      edu_sharing-community-common-docker-redis
    </docker.edu_sharing.community.common.redis.name>

    <docker.edu_sharing.community.common.redis.tag>
      8.2.10-2
    </docker.edu_sharing.community.common.redis.tag>

    <docker.edu_sharing.community.common.redis.exporter.name>
      edu_sharing-community-common-docker-redis-export
    </docker.edu_sharing.community.common.redis.exporter.name>

    <docker.edu_sharing.community.common.redis.exporter.tag>
      1.75.0
    </docker.edu_sharing.community.common.redis.exporter.tag>

    <docker.edu_sharing.community.common.redis-cluster.name>
      edu_sharing-community-common-docker-redis-cluster
    </docker.edu_sharing.community.common.redis-cluster.name>

    <docker.edu_sharing.community.common.redis-cluster.tag>
      8.2.10-2
    </docker.edu_sharing.community.common.redis-cluster.tag>

    <docker.edu_sharing.community.common.minio.name>
      edu_sharing-community-common-docker-minio
    </docker.edu_sharing.community.common.minio.name>

    <docker.edu_sharing.community.common.minio.tag>
      2025.7.23
    </docker.edu_sharing.community.common.minio.tag>

    <docker.edu_sharing.community.common.rustfs.name>
      edu_sharing-community-common-docker-rustfs
    </docker.edu_sharing.community.common.rustfs.name>

    <docker.edu_sharing.community.common.rustfs.tag>
      1.0.0-rc.5-2
    </docker.edu_sharing.community.common.rustfs.tag>

    <docker.edu_sharing.community.common.rabbitmq.name>
      edu_sharing-community-common-docker-rabbitmq
    </docker.edu_sharing.community.common.rabbitmq.name>

    <docker.edu_sharing.community.common.rabbitmq.tag>
      4.3.7-2
    </docker.edu_sharing.community.common.rabbitmq.tag>

    <!-- major-minor of the tag above with '-' instead of '.', part of the Helm name of the RabbitMQ StatefulSet
         (edusharing-services-rendering2-rabbitmq-4-3). Keep it in sync with the tag: a patch bump (4.3.7 -> 4.3.8)
         keeps the name and runs as a rolling upgrade, a minor bump (4.3 -> 4.4) changes the name and replaces the
         cluster (see docs/RABBITMQ-CLUSTER-AUSTAUSCH.md). -->
    <docker.edu_sharing.community.common.rabbitmq.series>
      4-3
    </docker.edu_sharing.community.common.rabbitmq.series>

    <docker.edu_sharing.community.common.mongodb.name>
      edu_sharing-community-common-docker-mongodb
    </docker.edu_sharing.community.common.mongodb.name>

    <docker.edu_sharing.community.common.mongodb.tag>
      8.0.34-2
    </docker.edu_sharing.community.common.mongodb.tag>

    <docker.edu_sharing.community.common.mongodb.exporter.name>
      edu_sharing-community-common-docker-mongodb-exporter
    </docker.edu_sharing.community.common.mongodb.exporter.name>

    <docker.edu_sharing.community.common.mongodb.exporter.tag>
      0.47.0
    </docker.edu_sharing.community.common.mongodb.exporter.tag>

    <docker.edu_sharing.community.common.minideb.name>
      edu_sharing-community-common-docker-minideb
    </docker.edu_sharing.community.common.minideb.name>

    <docker.edu_sharing.community.common.minideb.tag>
      12.0.1
    </docker.edu_sharing.community.common.minideb.tag>

    <!-- release-2 -->
    <bom.repository.version>${project.version}</bom.repository.version>

  </properties>

  <scm>
    <connection>
      scm:git:https://scm.edu-sharing.com/edu-sharing/community/services/edu-sharing-community-services-rendering2.git
    </connection>
    <developerConnection>
      scm:git:https://scm.edu-sharing.com/edu-sharing/community/services/edu-sharing-community-services-rendering2.git
    </developerConnection>
    <url>
      https://scm.edu-sharing.com/edu-sharing/community/services/edu-sharing-community-services-rendering2.git
    </url>
  </scm>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>false</activeByDefault>
        <property>
          <name>env.DEV</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <edu-sharing.project>enterprise-</edu-sharing.project>
        <bom.repository.version>${edu-sharing.project}${project.version}</bom.repository.version>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>

      <plugin>
        <groupId>com.github.tommyk-gears</groupId>
        <artifactId>bom-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>community-repository</id>
            <goals>
              <goal>import-properties</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <artifacts>
                <dependency>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>edu_sharing-community-repository</artifactId>
                  <!--suppress UnresolvedMavenProperty -->
                  <version>${bom.repository.version}</version>
                  <type>pom</type>
                </dependency>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>

      <dependency>
        <groupId>org.edu_sharing</groupId>
        <artifactId>edu_sharing-community-repository-backend-services-rest-client-java</artifactId>
        <version>${bom.repository.version}</version>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-service</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-document-converter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-jupyter-converter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.edu_sharing</groupId>
        <artifactId>edu_sharing-community-common-deployment-mongodb-compose</artifactId>
        <version>7.0.2</version>
      </dependency>

      <dependency>
        <groupId>org.edu_sharing</groupId>
        <artifactId>edu_sharing-community-common-deployment-onyx-compose</artifactId>
        <version>2025.05.1-0</version>
      </dependency>

      <dependency>
        <groupId>org.edu_sharing</groupId>
        <artifactId>edu_sharing-community-common-deployment-redis-cluster-compose</artifactId>
        <version>6.2-1</version>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-compose</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-bundle</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-document-converter</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-jupyter-converter</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-lumi</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-service</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>

      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-jupyter-converter</artifactId>
        <version>${project.version}</version>
      </dependency>
      -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-lumi</artifactId>
        <version>${project.version}</version>
        <classifier>bin</classifier>
        <type>zip</type>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-admin-frontend</artifactId>
        <version>${project.version}</version>
        <classifier>bin</classifier>
        <type>zip</type>
      </dependency>

      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-admin-frontend</artifactId>
        <version>${project.version}</version>
        <type>tar.gz</type>
        <classifier>bin</classifier>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>edusharing-remote</id>
      <url>https://artifacts.edu-sharing.com/repository/maven-remote/</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </snapshots>
    </repository>

    <repository>
      <id>edusharing-mirror</id>
      <url>https://artifacts.edu-sharing.com/repository/maven-mirror/</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </snapshots>
    </repository>

  </repositories>

  <modules>
    <module>deploy</module>
    <module>service</module>
    <module>document-converter</module>
    <module>jupyter-converter</module>
    <module>lumi</module>
    <module>admin-frontend</module>
  </modules>
</project>
