{
  "mappings": [
    {
      "name": "ddb-rest-items",
      "request": {
        "method": "GET",
        "urlPathPattern": "/ddb/rest/items/.*"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "binaries": {
