AWS_ACCESS_KEY_ID=rendering2
AWS_SECRET_ACCESS_KEY=rendering2
AWS_S3_ENDPOINT=http://localhost:9101
AWS_S3_MAX_FILE_LENGTH=1000
AWS_S3_TRUST_ALL_CERTIFICATES=false
AWS_S3_CHECKSUM_CALCULATION_WHEN_REQUIRED=false
AWS_S3_REGION=eu-central-1

MONGODB_URL=mongodb://localhost:9106
MONGODB_DB=lumi
MONGODB_USER=admin
MONGODB_PASSWORD=admin

CONTENT_AWS_S3_BUCKET=lumi-contentbucket
CONTENT_MONGO_COLLECTION=h5p

TEMPORARY_AWS_S3_BUCKET=lumi-tempbucket

LIBRARY_MONGO_COLLECTION=h5plibraries
LIBRARY_AWS_S3_BUCKET=lumi-libbucket

# Per-package H5P library cache: "global" = one shared library store (Mongo/S3, the two settings
# above), "package" = an isolated cache per imported package holding its exact library versions.
# In "package" mode the directory is the authoritative store for those libraries, so it must be
# writable and must survive restarts (a PVC in the chart, a named volume in compose).
H5P_LIBRARY_CACHE=package
H5P_LIBRARY_CACHE_DIR=./library-cache
# Size limit for that cache: a plain byte count or a human-readable size like "10GB" (binary units,
# as elsewhere). Empty or 0 = no limit. When it is reached, new imports are rejected with HTTP 507 -
# nothing already in the cache is evicted, because it is the only copy of those packages' libraries.
H5P_LIBRARY_CACHE_QUOTA=

EDUSHARING_MONGO_COLLECTION=edusharing

BASE_URL=/public/h5p

CACHE=in-memory
