<configuration xmlns="https://github.com/qoomon/maven-git-versioning-extension"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://github.com/qoomon/maven-git-versioning-extension https://qoomon.github.io/maven-git-versioning-extension/configuration-9.4.0.xsd">

  <refs considerTagsOnBranches="false">


    <ref type="tag">
      <pattern>.+</pattern>
      <version>${ref.slug}</version>
    </ref>

    <!-- feature branch -->
    <ref type="branch">
      <pattern><![CDATA[maven/feature/(?<version>\d+.\d+)(?=[-_]).+]]></pattern>
      <version>maven-fixes-${ref.version}-SNAPSHOT</version>
      <properties>
        <project.version.project>${env.PROJECT_NAME:-}maven-fixes-${ref.version}-SNAPSHOT</project.version.project>
      </properties>
    </ref>

    <!-- other branches -->
    <ref type="branch">
      <pattern>.+</pattern>
      <version>${ref.slug}-SNAPSHOT</version>
      <properties>
        <project.version.project>${env.PROJECT_NAME:-}${ref.slug}-SNAPSHOT</project.version.project>
      </properties>
    </ref>

  </refs>

  <rev>
    <version>${commit.short}${dirty.snapshot}</version>
  </rev>

</configuration>
